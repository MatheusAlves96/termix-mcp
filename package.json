{
  "name": "termix-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing the Termix REST API as tools, resources and prompts.",
  "type": "module",
  "license": "MIT",
  "author": "Matheus Alves",
  "homepage": "https://github.com/MatheusAlves96/termix-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatheusAlves96/termix-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/MatheusAlves96/termix-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "termix",
    "ssh",
    "llm-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "termix-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "specs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "husky || true",
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "spec:fetch": "tsx scripts/fetch-spec.ts",
    "spec:generate": "tsx scripts/generate.ts",
    "spec:inventory": "tsx scripts/inventory.ts",
    "spec:check-drift": "tsx scripts/check-drift.ts",
    "print-tools": "tsx src/index.ts --print-tools",
    "e2e:provision": "tsx scripts/e2e-provision.ts",
    "test:e2e": "vitest run test/e2e",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "semver": "^7.8.5",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@types/node": "^22.20.3",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "knip": "^6.36.0",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "prettier": "3.9.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
